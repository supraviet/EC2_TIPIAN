@model EC2_tipian.Models.CatalogoFiltrosModel

@{
    ViewData["Title"] = "Catálogo de Inmuebles";
}

<div class="container mt-4">
    <h1 class="display-4 text-center mb-4">🏠 Catálogo de Inmuebles</h1>

    <!-- Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🔍 Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Ciudad" class="form-label">Ciudad</label>
                    <select asp-for="Ciudad" asp-items="Model.Ciudades" class="form-select">
                        <option value="">Todas las ciudades</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="Tipo" class="form-label">Tipo de Inmueble</label>
                    <select asp-for="Tipo" asp-items="Model.TiposInmueble" class="form-select">
                        <option value="">Todos los tipos</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="PrecioMin" class="form-label">Precio Mínimo</label>
                    <input asp-for="PrecioMin" type="number" class="form-control" placeholder="Mínimo" min="0">
                    <span asp-validation-for="PrecioMin" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="PrecioMax" class="form-label">Precio Máximo</label>
                    <input asp-for="PrecioMax" type="number" class="form-control" placeholder="Máximo" min="0">
                    <span asp-validation-for="PrecioMax" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="Dormitorios" class="form-label">Dormitorios</label>
                    <select asp-for="Dormitorios" asp-items="Model.OpcionesDormitorios" class="form-select"></select>
                </div>

                <div class="col-12">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <a href="@Url.Action("Catalogo")" class="btn btn-outline-secondary">
                            <i class="fas fa-undo"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    <div class="row">
        @if (Model.Inmuebles.Any())
        {
            <div class="col-12 mb-3">
                <p class="text-muted">Mostrando @Model.Inmuebles.Count de @Model.TotalInmuebles inmuebles encontrados</p>
            </div>

            @foreach (var inmueble in Model.Inmuebles)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(inmueble.Imagen ?? "/images/default-property.jpg")" 
                             class="card-img-top" 
                             alt="@inmueble.Titulo"
                             style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">@inmueble.Tipo</span>
                            <h5 class="card-title">@inmueble.Titulo</h5>
                            <p class="card-text text-muted">
                                <i class="fas fa-map-marker-alt"></i> @inmueble.Ciudad, @inmueble.Direccion
                            </p>
                            
                            <div class="property-details mt-auto">
                                <div class="row text-center small text-muted">
                                    <div class="col-4">
                                        <i class="fas fa-bed"></i><br>
                                        @inmueble.Dormitorios dorm.
                                    </div>
                                    <div class="col-4">
                                        <i class="fas fa-bath"></i><br>
                                        @inmueble.Banos baños
                                    </div>
                                    <div class="col-4">
                                        <i class="fas fa-ruler-combined"></i><br>
                                        @inmueble.MetrosCuadrados m²
                                    </div>
                                </div>
                                
                                <div class="mt-3">
                                    <h4 class="text-primary">@inmueble.Precio.ToString("C")</h4>
                                </div>
                            </div>
                            
                            <a href="@Url.Action("Detalle", new { id = inmueble.Id })" 
                               class="btn btn-primary mt-2">
                                <i class="fas fa-eye"></i> Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Paginación -->
            @if (Model.TotalPaginas > 1)
            {
                <nav class="col-12">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                <a class="page-link" 
                                   href="@Url.Action("Catalogo", new { 
                                       Ciudad = Model.Ciudad,
                                       Tipo = Model.Tipo,
                                       PrecioMin = Model.PrecioMin,
                                       PrecioMax = Model.PrecioMax,
                                       Dormitorios = Model.Dormitorios,
                                       Pagina = i 
                                   })">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <h4>No se encontraron inmuebles</h4>
                    <p class="mb-0">Intenta ajustar los filtros de búsqueda</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Validación cliente-side para precios
        document.querySelector('form').addEventListener('submit', function(e) {
            const precioMin = document.getElementById('PrecioMin').value;
            const precioMax = document.getElementById('PrecioMax').value;
            
            if (precioMin && precioMax && parseFloat(precioMin) > parseFloat(precioMax)) {
                e.preventDefault();
                alert('El precio mínimo no puede ser mayor al precio máximo');
            }
        });
    </script>
}