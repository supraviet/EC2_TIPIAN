@model EC2_tipian.Models.Inmueble

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <!-- Carousel de imágenes -->
            <div id="propertyCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner rounded">
                    <div class="carousel-item active">
                        <img src="@(Model.Imagen ?? "/images/default-property.jpg")" 
                             class="d-block w-100" 
                             alt="@Model.Titulo"
                             style="height: 400px; object-fit: cover;">
                    </div>
                </div>
            </div>

            <!-- Información del inmueble -->
            <div class="card">
                <div class="card-header">
                    <h2 class="h4 mb-0">@Model.Titulo</h2>
                    <span class="badge bg-primary">@Model.Tipo</span>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        <i class="fas fa-map-marker-alt"></i> @Model.Direccion, @Model.Ciudad
                    </p>
                    
                    <div class="row text-center mb-4">
                        <div class="col-3">
                            <div class="border rounded p-2">
                                <i class="fas fa-bed fa-2x text-primary"></i>
                                <div class="mt-1">
                                    <strong>@Model.Dormitorios</strong><br>
                                    <small>Dormitorios</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2">
                                <i class="fas fa-bath fa-2x text-primary"></i>
                                <div class="mt-1">
                                    <strong>@Model.Banos</strong><br>
                                    <small>Baños</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2">
                                <i class="fas fa-ruler-combined fa-2x text-primary"></i>
                                <div class="mt-1">
                                    <strong>@Model.MetrosCuadrados m²</strong><br>
                                    <small>Área</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2">
                                <i class="fas fa-tag fa-2x text-primary"></i>
                                <div class="mt-1">
                                    <strong>@Model.Codigo</strong><br>
                                    <small>Código</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="text-primary">@Model.Precio.ToString("C")</h4>

                    <div class="mt-4">
                        <a href="@Url.Action("Catalogo")" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left"></i> Volver al Catálogo
                        </a>
                        
                        <!-- Botón para agendar visita (Pregunta 3) -->
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#visitaModal">
                            <i class="fas fa-calendar-check"></i> Agendar Visita
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-md-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">💼 ¿Interesado en este inmueble?</h5>
                </div>
                <div class="card-body text-center">
                    <p>Contacta con uno de nuestros asesores</p>
                    <button class="btn btn-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#visitaModal">
                        <i class="fas fa-calendar-alt"></i> Agendar Visita
                    </button>
                    <button class="btn btn-outline-primary w-100">
                        <i class="fas fa-phone"></i> Llamar Ahora
                    </button>
                    
                    <hr>
                    
                    <div class="text-start">
                        <h6>Características:</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success"></i> Inspección previa</li>
                            <li><i class="fas fa-check text-success"></i> Documentación legal</li>
                            <li><i class="fas fa-check text-success"></i> Financiamiento disponible</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agendar visita (se completará en Pregunta 3) -->
<div class="modal fade" id="visitaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agendar Visita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-lock fa-3x text-warning mb-3"></i>
                <h5>Función disponible próximamente</h5>
                <p class="text-muted">Esta característica se habilitará en la siguiente fase del desarrollo.</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .property-details .row { border-top: 1px solid #eee; padding-top: 10px; }
        .card { transition: transform 0.2s; }
        .card:hover { transform: translateY(-5px); }
        .badge { font-size: 0.8em; }
    </style>
}